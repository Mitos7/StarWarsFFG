<section class="data-importer-window dialog">
  <div class="skilllist">
    <table>
      <thead>
        <tr>
          <th class="skilltheme">{{localize "SWFFG.SkillImportTheme"}}</th>
          <th>{{localize "SWFFG.SkillImportActive"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each themes as |theme|}}
          <tr>
            <td class="skilltheme">{{theme.name}}</td>
            <td class="skillactive">
              {{#if theme.isactive}}<i class="fas fa-check-circle"></i>{{else}}<i class="fas fa-times-circle"></i>{{/if}}
            </td>
            <td>
              <button type="button" data-action="download-skills" data-id="{{theme.name}}" title="{{localize 'SWFFG.SkillDownload'}}">
                <i class="fas fa-download"></i>
              </button>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  <div class="skillimport">
    <p class="notes">{{localize "SWFFG.SkillImportInstructions1"}}</p>
    <p class="notes">{{localize "SWFFG.SkillImportInstructions2"}}</p>
    <p class="notes">{{localize "SWFFG.SkillImportInstructions3"}} <a href="https://github.com/StarWarsFoundryVTT/StarWarsFFG/wiki" target="_blank" rel="noopener noreferrer">Documentation</a></p>
    <div class="form-group">
      <label for="swffg-skill-import-data"><b>{{localize "SWFFG.SkillImportSource"}}</b></label>
      <input type="file" id="swffg-skill-import-data" name="data" accept=".json,application/json" />
    </div>
    <div class="dialog-buttons">
      <button type="button" data-action="import-skills">
        <i class="fas fa-file-import"></i> {{localize "SWFFG.ImportFile"}}
      </button>
      <button type="button" data-action="reset-skills">
        <i class="fas fa-undo"></i> {{localize "SWFFG.ResetSkillList"}}
      </button>
    </div>
  </div>
</section>
